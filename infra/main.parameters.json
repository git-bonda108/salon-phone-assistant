{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION=switzerlandnorth}" },
    "ownerObjectId": { "value": "${AZURE_OWNER_OBJECT_ID=}" },
    "deployJudge": { "value": "${DEPLOY_JUDGE=false}" },
    "calendarBackend": { "value": "${CALENDAR_BACKEND=sqlite}" },
    "graphAuth": { "value": "${GRAPH_AUTH=delegated}" },
    "graphClientId": { "value": "${GRAPH_CLIENT_ID=}" },
    "graphCalendars": { "value": "${GRAPH_CALENDARS={}}" },
    "apiImage": { "value": "${SERVICE_API_IMAGE_NAME=mcr.microsoft.com/k8se/quickstart:latest}" }
  }
}
