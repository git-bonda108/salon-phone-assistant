# --- calendar -----------------------------------------------------------
CALENDAR_BACKEND=google                    # google | sqlite (local demo)
GOOGLE_SERVICE_ACCOUNT_JSON=/secrets/service-account.json   # path or the JSON itself
GOOGLE_CALENDAR_IDS={"lara":"xxx@group.calendar.google.com","marco":"yyy@group.calendar.google.com","sina":"zzz@group.calendar.google.com"}

# --- security -----------------------------------------------------------
TOOL_API_KEY=change-me-long-random         # Suisse Line live tools send it as X-Api-Key
WEBHOOK_SECRET=change-me                   # HMAC-SHA256 secret of the Suisse Line webhook
WEBHOOK_SIGNATURE_HEADER=X-Signature
ADMIN_TOKEN=change-me                      # /admin?token=...

# --- empty-chair recovery -------------------------------------------------
NOTIFY_WEBHOOK_URL=https://your-n8n.example/webhook/salon-offers   # starts outbound call / SMS
NOTIFY_SIGNING_SECRET=change-me
OFFER_TTL_MINUTES=20

# --- misc ---------------------------------------------------------------
DATABASE_PATH=/data/app.db
SALON_CONFIG=data/salon.json
