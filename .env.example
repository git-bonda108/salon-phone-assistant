# Local development. In Azure these come from Bicep (infra/main.bicep) and Key Vault; nothing is stored here.

# --- calendar ------------------------------------------------------------
CALENDAR_BACKEND=sqlite                     # sqlite (local) | google | outlook
# google
GOOGLE_SERVICE_ACCOUNT_JSON=/secrets/service-account.json
GOOGLE_CALENDAR_IDS={"lara":"…@group.calendar.google.com","marco":"…","sina":"…"}
# outlook / Microsoft 365 (see docs/operations/outlook-setup.md)
GRAPH_AUTH=delegated                        # delegated (token cache) | app (managed identity)
GRAPH_CLIENT_ID=
GRAPH_TOKEN_CACHE=graph-token-cache.json
GRAPH_CALENDARS={"lara":{"user":"me","calendar_id":"…"}}

# --- security (in Azure: generated into Key Vault on first start) --------
TOOL_API_KEY=dev-tool-key
ADMIN_TOKEN=dev-admin-token
WEBHOOK_SECRET=dev-webhook-secret
WEBHOOK_SIGNATURE_HEADER=X-Signature

# --- Azure AI (Switzerland North, keyless via `az login` locally) -------------
AZURE_AI_ENDPOINT=                          # https://ais-lina-….cognitiveservices.azure.com  (empty = offline rules)
AZURE_OPENAI_ENDPOINT=                      # https://ais-lina-….openai.azure.com             (empty = agents offline)
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_JUDGE_DEPLOYMENT=gpt-4.1-mini

# --- empty-chair recovery -------------------------------------------------
NOTIFY_WEBHOOK_URL=                         # n8n / Make / Zapier → outbound call or SMS
OFFER_TTL_MINUTES=20
DATABASE_PATH=var/app.db
